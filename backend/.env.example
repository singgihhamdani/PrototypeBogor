# ============================================
# SIJAKON Backend - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================

# Application
NODE_ENV=development
PORT=4000

# PostgreSQL 16 + PostGIS
DATABASE_URL="postgresql://your_db_user:your_db_password@localhost:5432/sijakon_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (generate strong random strings!)
# Example: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_use_openssl_rand_base64_64
JWT_EXPIRATION=3600s
REFRESH_TOKEN_SECRET=CHANGE_ME_different_secret_for_refresh
REFRESH_TOKEN_EXPIRATION=604800s

# MinIO / S3 Object Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=your_minio_access_key
S3_SECRET_KEY=your_minio_secret_key
S3_BUCKET_NAME=sijakon-files
